# Kept only on this computer. Never put this key in the Mod or browser source.
OPENAI_API_KEY=

# Realtime model documented by OpenAI at the time this Gateway was added.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Keep ordinary conversation and game commands responsive. Use high only when
# extra planning latency is acceptable.
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_VOICE=marin

# The Gateway intentionally only binds to loopback.
DST_GATEWAY_HOST=127.0.0.1
DST_GATEWAY_PORT=8080

# Uses Node's built-in node:sqlite on Node 22.13+; set :memory: for tests only.
DST_GATEWAY_DATABASE=data/dst-gpt-agent.sqlite

# Airi Tamagotchi server channel (Settings -> Connections).
AIRI_WS_URL=ws://127.0.0.1:6121/ws
AIRI_AUTH_TOKEN=
AIRI_MODULE_NAME=dst-companion
